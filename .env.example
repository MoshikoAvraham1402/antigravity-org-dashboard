# ==============================================================================
# Antigravity Organization Usage & FinOps Dashboard — Customer Configuration
# Copy this file to `.env` for local development or pass via `./install.sh`
# ==============================================================================

# [REQUIRED] Host Google Cloud Project ID where BigQuery & Cloud Run reside
GCP_PROJECT_ID=your-gcp-project-id

# [OPTIONAL] Numeric Project Number (auto-discovered if omitted; required only if REQUIRE_IAP_AUTH=true)
GCP_PROJECT_NUMBER=

# [OPTIONAL] Cloud Run deployment region & BigQuery dataset location
GCP_REGION=us-central1
BQ_LOCATION=US

# [OPTIONAL] Google Cloud Organization ID & Workspace Domain (displayed in UI & used for Org Log Sink)
GCP_ORG_ID=
GCP_ORG_DOMAIN=example.com

# [OPTIONAL] Organization Timezone (IANA format) used for the 7x24 Engineering Velocity Heatmap
ORG_TIMEZONE=UTC

# [OPTIONAL] BigQuery Dataset & Cloud Logging Sink Identifiers
MONITORING_DATASET=antigravity_monitoring
RAW_LOGS_DATASET=antigravity_raw_logs
LOGGING_SINK_NAME=antigravity-org-bq-sink

# [OPTIONAL] Explicit comma-separated list of GCP Project IDs to scan during live "Sync Data"
# When blank, the backend automatically discovers all ACTIVE projects visible to the service account!
ORG_PROJECTS=

# [OPTIONAL] Link your BigQuery Cloud Billing Standard Export table to enable the FinOps SKU Reconciliation tab
# Format: project_id.dataset_id.gcp_billing_export_v1_XXXXXX_XXXXXX_XXXXXX
# Must reside in the same BigQuery multi-region/location as MONITORING_DATASET (e.g., EU or US).
BILLING_EXPORT_TABLE=

# [SECURITY] Identity-Aware Proxy (IAP) JWT Verification
# Set to "true" when running behind Google Cloud Run native IAP (recommended for enterprise internal access).
# Set to "false" if exposing publicly or handling authentication at an upstream Load Balancer.
REQUIRE_IAP_AUTH=false
IAP_AUDIENCE=

# [FINOPS GUARDRAIL] Per-query BigQuery scan ceiling in bytes (Default: 157286400 = 150 MB)
MAX_BYTES_BILLED=157286400
